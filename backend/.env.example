MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/todoapp?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional dedicated secret for encrypting account Gemini API keys.
# When omitted, encryption derives a separate key from JWT_SECRET.
# Keep this value stable; changing it requires users to save their keys again.
AI_KEY_ENCRYPTION_KEY=

# Connected account OAuth apps. Use HTTPS and a same-host /api proxy in production.
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
