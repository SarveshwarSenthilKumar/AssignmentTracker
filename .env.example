MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/todoapp?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Accounts allowed to publish/edit the public site roadmap (comma-separated registered emails).
# Leave empty to disable roadmap editing. Restart the backend after changing.
SITE_ROADMAP_EDITOR_EMAILS=

# Optional bug-report reviewers; defaults to SITE_ROADMAP_EDITOR_EMAILS if unset.
BUG_REPORT_EDITOR_EMAILS=

# Optional feature-suggestion reviewers; falls back to bug-report then roadmap editors.
FEATURE_SUGGESTION_EDITOR_EMAILS=
